<Window x:Class="SpiderSolitaireWithCheat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="蜘蛛纸牌"
        Height="800" Width="1200"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource TableBrush}"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource BarFgBrush}" />
            <Setter Property="Background" Value="{DynamicResource BtnBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BtnBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource BarFgBrush}" />
            <Setter Property="Background" Value="{DynamicResource BtnBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BtnBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnActiveBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Stat" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource StatFgBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BarBrush}" Padding="12,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="BtnNew" Content="新游戏" Style="{StaticResource ToolButton}"
                            ToolTip="按当前难度开始新游戏" Click="OnNewGame" />
                    <ComboBox x:Name="CmbDifficulty" Width="112" Margin="6,0,0,0"
                              VerticalAlignment="Center" SelectedIndex="0" Focusable="False"
                              ToolTip="难度在下一次「新游戏」时生效">
                        <ComboBoxItem>单花色（简单）</ComboBoxItem>
                        <ComboBoxItem>双花色（中等）</ComboBoxItem>
                        <ComboBoxItem>四花色（困难）</ComboBoxItem>
                    </ComboBox>
                    <Button x:Name="BtnUndo" Content="撤销" Margin="6,0,0,0"
                            Style="{StaticResource ToolButton}" ToolTip="撤销上一步 (Ctrl+Z)" Click="OnUndo" />
                    <Button x:Name="BtnHint" Content="提示" Margin="6,0,0,0"
                            Style="{StaticResource ToolButton}" ToolTip="高亮一个可行走法 (H)" Click="OnHint" />
                    <Rectangle Width="1" Height="20" Fill="{DynamicResource BtnBorderBrush}" Margin="10,0" />
                    <Button x:Name="BtnFlip" Content="翻牌" Margin="6,0,0,0"
                            Style="{StaticResource ToolButton}" Click="OnFlipHidden"
                            ToolTip="作弊：翻开所有暗牌，可用 Ctrl+Z 撤销 (P)" />
                    <ToggleButton x:Name="TglForce" Content="强制移牌" Margin="6,0,0,0"
                                  Style="{StaticResource ToolToggle}" Click="OnForceToggled"
                                  ToolTip="作弊：任意明牌可移到任意列（不限同花降序与点数），发牌不再受空列限制 (F)" />
                    <ToggleButton x:Name="TglSound" Content="🔊" Margin="6,0,0,0"
                                  Style="{StaticResource ToolToggle}" IsChecked="True" Click="OnSoundToggled"
                                  ToolTip="音效开关 (M)" />
                    <ToggleButton x:Name="TglTheme" Content="🌙" Margin="6,0,0,0"
                                  Style="{StaticResource ToolToggle}" Click="OnThemeToggled"
                                  ToolTip="深色模式 (T)，启动时跟随系统" />
                    <Button x:Name="BtnHelp" Content="ℹ" Margin="6,0,0,0"
                            Style="{StaticResource ToolButton}" ToolTip="查看规则与帮助" Click="OnHelp" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtScore" Style="{StaticResource Stat}" />
                    <TextBlock x:Name="TxtMoves" Style="{StaticResource Stat}" Margin="14,0,0,0" />
                    <TextBlock x:Name="TxtTime" Style="{StaticResource Stat}" Margin="14,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource BottomBrush}" Padding="10,6" Margin="0,4,0,0">
            <Canvas x:Name="BottomCanvas" Height="128" />
        </Border>

        <!-- 牌桌置于底栏之后，保证拖动的牌始终渲染在最上层 -->
        <Canvas Grid.Row="1" x:Name="TableauCanvas" Margin="10,6,10,0" ClipToBounds="False" />

        <Grid x:Name="OverlayRoot" Grid.RowSpan="3" Background="#44000000"
              Visibility="Collapsed" MouseLeftButtonDown="OnOverlayDismiss">
            <Border x:Name="OverlayBox"
                    Background="{DynamicResource OverlayBrush}" BorderBrush="{DynamicResource BtnBorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="30,24" MaxWidth="620"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="OverlayTitle" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource BarFgBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="OverlayBody" FontSize="14" LineHeight="22"
                               Foreground="{DynamicResource OverlayFgBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                               HorizontalAlignment="Center" TextAlignment="Left" />
                    <Button x:Name="BtnOverlayAction" Content="再来一局" Style="{StaticResource ToolButton}"
                            Margin="0,18,0,0" HorizontalAlignment="Center" Visibility="Collapsed"
                            Click="OnOverlayAction" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
